# Terasic C5G (Cyclone V GX Starter Kit); pins from Terasic C5G_Default.qsf
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC5C6F27C7
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name VERILOG_FILE ../hdl/top.v
set_global_assignment -name VERILOG_FILE ../hdl/fu.v
set_global_assignment -name VERILOG_FILE ../generated/hls_core.v
set_global_assignment -name SDC_FILE hls.sdc
set_location_assignment PIN_R20 -to CLOCK_50_B5B
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50_B5B
set_location_assignment PIN_AB24 -to CPU_RESET_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CPU_RESET_n
